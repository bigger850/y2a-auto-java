# ===== Java / Maven =====
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ===== Node / 前端 =====
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ===== 运行时数据（含 Cookie 等敏感信息，严禁提交）=====
storage/
!storage/.gitkeep
logs/
downloads/
temp/
cookies/

# 运行时配置目录（必须锚定根目录，否则会误伤
# src/main/java/.../common/config 与 domain/config）
/config/

# 运行时数据库目录（同理，不能匹配 src/main/resources/db/migration）
/db/
y2a-server/db/

# Flyway 迁移脚本必须纳入版本控制
!y2a-server/src/main/resources/db/
!y2a-server/src/main/resources/db/migration/
!y2a-server/src/main/resources/db/migration/*.sql

# ===== 敏感文件 =====
*.cookies
*_cookies.json
yt_cookies.txt
.env
.env.local
.env.*.local
*.pem
*.key
secret*
application-local.yml
application-prod.yml

# ===== IDE / 编辑器 =====
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 临时 / 备份 =====
*.log
*.tmp
*.bak
*.orig
*.rej
tmp/
_bootstrap*

# Windows 保留设备名（避免误创建）
CON
PRN
AUX
NUL
